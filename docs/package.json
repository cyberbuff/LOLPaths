{
  "name": "lolpaths-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run generate && NODE_OPTIONS=--no-deprecation next build && bun run generate",
    "dev": "portless",
    "dev:app": "next dev --turbo",
    "generate": "cd .. && UV_CACHE_DIR=.uv-cache uv run lolpaths generate",
    "start": "next start",
    "check": "bun run generate && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "portless": {
    "name": "lolpaths-docs",
    "script": "dev:app"
  },
  "overrides": {
    "@radix-ui/react-scroll-area": "1.2.18"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-ui": "16.14.5",
    "lucide-react": "1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "portless": "0.15.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
